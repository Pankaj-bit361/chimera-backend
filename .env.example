# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call this API, or * for any origin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27018/chimera   (npm run db:up starts it)
#             Host port 27018, not 27017 — see docker-compose.yml.
# Production: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/chimera
MONGODB_URI=mongodb://localhost:27018/chimera

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
JWT_TTL=12h
# Optional. Signs gated-document download links. Derived from JWT_SECRET when
# unset; if you set it, it MUST differ from JWT_SECRET.
DOCUMENT_LINK_SECRET=
DOCUMENT_LINK_TTL_MINUTES=60

# ─── Storage adapter ─────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/uploads
# Public base the API serves local files from (used to build media URLs)
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads
# --- s3 only ---
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN/base URL in front of the bucket for ungated assets
S3_PUBLIC_URL=

# ─── Mail adapter ────────────────────────────────────────────────────────────
# file | volanea
MAIL_DRIVER=file
LOCAL_MAIL_DIR=./var/mail
# D1 (see DECISIONS.md): the domain every inbox is derived from
MAIL_DOMAIN=chimera-biotech.com
MAIL_FROM_NAME=Chimera Biotech
# Routed inboxes — §9 8.3. Defaults derive from MAIL_DOMAIN if left blank.
MAIL_INBOX_INFO=
MAIL_INBOX_SALES=
MAIL_INBOX_EXPORTS=
# --- volanea only ---
VOLANEA_HOST=
VOLANEA_PORT=587
VOLANEA_USER=
VOLANEA_PASSWORD=

# ─── Public site revalidation ────────────────────────────────────────────────
# Publishing in the dashboard pings Next.js to rebuild the affected routes.
WEB_BASE_URL=http://localhost:3000
REVALIDATE_SECRET=dev-only-change-me-2222222222222222222222222222222222222222

# ─── Business config ─────────────────────────────────────────────────────────
# D5 (see DECISIONS.md): quote | indicative
PRICING_MODE=quote

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@chimera-biotech.com
SEED_OWNER_PASSWORD=ChangeMe!2026
